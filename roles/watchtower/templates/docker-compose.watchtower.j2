services:

  watchtower:
    image: {{ watchtower_image }}
    container_name: {{ watchtower_container }}
    restart: unless-stopped
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock
    command:
      - --interval
      - "{{ watchtower_interval }}"
{% if watchtower_label_enable %}
      - --label-enable
{% endif %}
{% if watchtower_cleanup %}
      - --cleanup
{% endif %}
{% if watchtower_notifications %}
      - --notifications
      - "{{ watchtower_notification_url }}"
{% endif %}
    environment:
      - TZ=Europe/Paris