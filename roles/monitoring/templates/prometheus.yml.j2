global:
  # How often Prometheus scrapes metrics
  scrape_interval: 15s
  # How often Prometheus evaluates alerting rules
  evaluation_interval: 15s

scrape_configs:

  # ── PROMETHEUS SELF MONITORING ─────────────────────────────
  - job_name: "prometheus"
    static_configs:
      - targets: ["{{ prometheus_container }}:9090"]

  # ── RASPBERRY PI SYSTEM METRICS ────────────────────────────
  - job_name: "node-exporter"
    static_configs:
      - targets: ["{{ node_exporter_container }}:9100"]

  # ── PROJECT SERVICES ───────────────────────────────────────
  # Add your project containers here when needed
  # Example:
  # - job_name: "project-a-api"
  #   static_configs:
  #     - targets: ["container_name:port"]